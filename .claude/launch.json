{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "prototype/serve.mjs"
      ],
      "port": 8123,
      "autoPort": true
    },
    {
      "name": "dist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "prototype/serve.mjs",
        "--dist"
      ],
      "port": 8124,
      "autoPort": true
    },
    {
      "name": "dist-no-isolation",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "prototype/serve.mjs",
        "--dist",
        "--no-isolation"
      ],
      "port": 8125,
      "autoPort": true
    }
  ]
}